# App
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3001","http://localhost:5173"]

# Database (Neon Postgres — get your URL from https://console.neon.tech)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxxx.us-east-2.aws.neon.tech/deepagent?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth (Clerk — get keys from https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# AI Guardrails (Jev by TypeSafe AI)
TYPESAFE_API_KEY=your-jev-api-key
JEV_MODEL=jev-1.14.0

# LLM Providers
GOOGLE_GENAI_API_KEY=your-gemini-key
DEEPSEEK_API_KEY=your-deepseek-key
OPENROUTER_API_KEY=your-openrouter-key
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key

# LLM Defaults (override per-session or per-request)
LLM_DEFAULT_PROVIDER=gemini
LLM_DEFAULT_MODEL=gemini-2.5-flash
LLM_REASONING_MODEL=gemini-2.5-pro
LLM_FAST_MODEL=gemini-2.5-flash
LLM_CODING_MODEL=deepseek-chat

# Embeddings & Re-ranking (Cohere — free trial tier)
COHERE_API_KEY=your-cohere-trial-key

# Search
EXA_API_KEY=your-exa-key

# Observability (LangFuse — self-hosted or cloud)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Celery (periodic jobs only)
CELERY_BROKER_URL=redis://localhost:6379/1

# Browser
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=50
BROWSER_TIMEOUT=30000

# Security
RATE_LIMIT_PER_MINUTE=30
