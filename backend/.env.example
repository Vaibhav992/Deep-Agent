# ============================================================
# Deep Agent — Environment Variables
# Copy this to .env and fill in your API keys
# ============================================================

# App
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3001","http://localhost:5173"]

# Database — Docker Compose uses local PostgreSQL with pgvector
# For cloud (Neon): postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/deepagent?sslmode=require
# config.py auto-fixes postgresql:// to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://deepagent:deepagent@localhost:5432/deepagent

# Redis — Docker Compose runs local Redis
# For cloud (Upstash): set UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth (Clerk — https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# AI Guardrails (Jev via typesafe-sdk — https://console.typesafe.ai)
TYPESAFE_API_KEY=your-typesafe-api-key
JEV_MODEL=jev-latest

# LLM Providers (at least ONE required — Gemini recommended for start)
GOOGLE_GENAI_API_KEY=your-gemini-api-key
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Defaults
LLM_DEFAULT_PROVIDER=gemini
LLM_DEFAULT_MODEL=gemini-2.5-flash
LLM_REASONING_MODEL=gemini-2.5-pro
LLM_FAST_MODEL=gemini-2.5-flash
LLM_CODING_MODEL=deepseek-chat

# Embeddings & Re-ranking (Cohere — free trial: https://dashboard.cohere.com)
COHERE_API_KEY=your-cohere-trial-key

# Search (Exa — https://exa.ai)
EXA_API_KEY=your-exa-key

# Observability (optional — LangFuse: https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Kafka (disabled by default — not needed for local dev)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false

# Celery (uses Redis as broker)
CELERY_BROKER_URL=redis://localhost:6379/1

# Browser
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=50
BROWSER_TIMEOUT=30000

# Security
RATE_LIMIT_PER_MINUTE=30
