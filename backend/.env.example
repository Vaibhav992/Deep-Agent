# App
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3001","http://localhost:5173"]

# Database (Neon Postgres — get URL from https://console.neon.tech)
# config.py auto-fixes postgresql:// to postgresql+asyncpg://
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/deepagent?sslmode=require

# Redis — pick ONE:
# Option 1: Upstash (production/serverless — get from https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Option 2: Local Redis (dev only — comment out Upstash vars above)
REDIS_URL=redis://localhost:6379/0

# Auth (Clerk — get keys from https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# AI Guardrails (Jev via typesafe-sdk — get key from https://console.typesafe.ai)
TYPESAFE_API_KEY=your-typesafe-api-key
JEV_MODEL=jev-latest

# LLM Providers
GOOGLE_GENAI_API_KEY=your-gemini-key
DEEPSEEK_API_KEY=your-deepseek-key
OPENROUTER_API_KEY=your-openrouter-key
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key

# LLM Defaults (override per-session or per-request)
LLM_DEFAULT_PROVIDER=gemini
LLM_DEFAULT_MODEL=gemini-2.5-flash
LLM_REASONING_MODEL=gemini-2.5-pro
LLM_FAST_MODEL=gemini-2.5-flash
LLM_CODING_MODEL=deepseek-chat

# Embeddings & Re-ranking (Cohere — free trial tier)
COHERE_API_KEY=your-cohere-trial-key

# Search
EXA_API_KEY=your-exa-key

# Observability (LangFuse Cloud — https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Kafka (local dev only — Upstash Kafka shut down March 2025)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false

# Celery (periodic jobs only)
CELERY_BROKER_URL=redis://localhost:6379/1

# Browser
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=50
BROWSER_TIMEOUT=30000

# Security
RATE_LIMIT_PER_MINUTE=30
